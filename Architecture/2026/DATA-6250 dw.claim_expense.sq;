
CREATE OR REPLACE TABLE dw.claim_expense
(
	claim_expense_id bigint NOT NULL GENERATED BY DEFAULT AS IDENTITY  COMMENT 'Unique ID of the Claim Expense table.',
	claim_transaction_source_id STRING NOT NULL COMMENT 'Foreign Key of the transaction from the source system.',
	claim_id BIGINT NOT NULL COMMENT 'Foreign Key to the Claim table.',
	claim_transaction_id BIGINT NOT NULL COMMENT 'Primary Key of the claim_transaction_type table.',
	transaction_date DATE COMMENT 'Transaction date.',
	transaction_status STRING COMMENT 'Status of the claim expense transaction.',
	transaction_group_status STRING COMMENT 'Standardized status of the claim expense transaction.',
	transaction_status_date DATE COMMENT 'Date of the transaction status.',
	gl_book_date DATE COMMENT 'Date transaction was printed and entered into GL (EAS).  
	accounting_date DATE COMMENT 'Accounting date.',
	expense_amount decimal(13,2) COMMENT 'Amount of the expense.',
	record_source string COMMENT 'Source system of record.',
	issue_company string COMMENT 'Issuing company of the claim expense record.',
	CONSTRAINT PK_claim_expense PRIMARY KEY (claim_expense_id, claim_transaction_source_id, claim_id, claim_transaction_id),
	CONSTRAINT FK_claim_to_claim_expense FOREIGN KEY (claim_id) REFERENCES dw.claim (claim_id),
	CONSTRAINT FK_claim_transaction_ty_to_claim_expense FOREIGN KEY (claim_transaction_id) REFERENCES dw.claim_transaction_type (claim_transaction_id)
)
USING delta
COMMENT 'The \'claim_expense\' table contains records of expenses related to MPL insurance claims. It includes details such as the transaction type, date, expense amount, record source, and the issuing company. This data can be used to analyze claim-related expenses, track the source of records, and identify trends in claim-related costs. It can also help in identifying the most common types of claims and their associated costs, which can inform underwriting and risk management strategies.'
TBLPROPERTIES ('delta.autoOptimize.autoCompact'='true','delta.autoOptimize.optimizeWrite'='true');

alter table dw.claim_expense
set owner to data_engineering;
